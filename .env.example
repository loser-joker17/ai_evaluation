# Copy to .env and fill in. Never commit .env.

# --- models (app/llm.py)
NVIDIA_API_KEY=
UNOROUTER_API_KEY=
TAVILY_API_KEY=
FAST_MODEL=openai/gpt-oss-20b
LIGHT_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-20b
JUDGE_BACKUP_PROVIDER=unorouter
JUDGE_BACKUP_MODEL=gpt-oss-20b:free
LLM_BACKUP_PROVIDER=unorouter
LLM_BACKUP_MODEL=gpt-oss-20b:free

# --- service (app/config.py)
INTERNAL_API_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_URL=                # e.g. http://backend:8080/internal/evaluations
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_TTL_S=3600
ENABLE_SYNC_EVALUATE=false
LOG_LEVEL=INFO
LOG_JSON=true
# EVALUATOR_VERSION=2026.10.19   # bump when rules/prompts/models change

